# Copy this file to .env.local and fill in the values from your Supabase
# project's dashboard: Project Settings → API.
#
# NEXT_PUBLIC_SUPABASE_URL is the "Project URL".
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is the "publishable" API key (the
# current replacement for the legacy "anon" key) — safe to expose in the
# browser. Never put the secret/service_role key or database password here.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional — "Find trips for us" runs on mock data without this. Get a test
# token from your Duffel dashboard: More -> Developers -> Access tokens.
# Server-side only (no NEXT_PUBLIC_ prefix) — never sent to the browser.
DUFFEL_API_KEY=
